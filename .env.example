# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
# fake = offline scripted LLM (tests); anthropic = real calls.
# Leave unset to pick automatically: anthropic if ANTHROPIC_API_KEY is set, otherwise fake.
# BATON_LLM=fake
# Model for BATON_LLM=anthropic. Default: claude-sonnet-5-5
# BATON_MODEL=claude-sonnet-5-5
# Let the API retry a refused request on a fallback model (server-side fallbacks beta).
# BATON_LLM_FALLBACKS=true

# --- Database ---
DATABASE_URL=sqlite:///./baton.db

# --- AOPs and prompts (defaults: <repo>/aops and <repo>/prompts) ---
# AOPS_DIR=./aops
# PROMPTS_DIR=./prompts

# --- Guardrails ---
# Refunds up to this many cents are issued automatically; anything larger escalates to a human.
# BATON_REFUND_AUTO_LIMIT_CENTS=10000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Mock commerce (Northwind Goods) ---
MOCK_COMMERCE_URL=http://localhost:8100
MOCK_COMMERCE_DATABASE_URL=sqlite:///./mock_commerce.db

# --- Channels (Part 04). Leave blank to use console senders in dev ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=support@northwind.example
