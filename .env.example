# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
# fake = offline scripted LLM (tests); anthropic = real calls.
# Leave unset to pick automatically: anthropic if ANTHROPIC_API_KEY is set, otherwise fake.
# BATON_LLM=fake
# Model for BATON_LLM=anthropic. Default: claude-sonnet-5-5
# BATON_MODEL=claude-sonnet-5-5
# Let the API retry a refused request on a fallback model (server-side fallbacks beta).
# BATON_LLM_FALLBACKS=true

# --- Database ---
DATABASE_URL=sqlite:///./baton.db

# --- AOPs and prompts (defaults: <repo>/aops and <repo>/prompts) ---
# AOPS_DIR=./aops
# PROMPTS_DIR=./prompts

# --- Knowledge base (help center) ---
# hashing = offline, no key (default). voyage = Voyage AI embeddings (needs VOYAGE_API_KEY).
# Changing the embedder means re-running `uv run baton-kb ingest`.
# BATON_EMBEDDER=hashing
# VOYAGE_API_KEY=
# BATON_EMBED_MODEL=voyage-3.5
# Re-order retrieval candidates with one extra LLM call per search.
# BATON_KB_RERANK=false
# Where [kb:article_id] citations link to.
# BATON_KB_BASE_URL=https://help.northwind.example/articles/
# KB_DIR=./data/kb

# --- Guardrails ---
# Refunds up to this many cents are issued automatically; anything larger escalates to a human.
# BATON_REFUND_AUTO_LIMIT_CENTS=10000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Mock commerce (Northwind Goods) ---
MOCK_COMMERCE_URL=http://localhost:8300
MOCK_COMMERCE_DATABASE_URL=sqlite:///./mock_commerce.db

# --- Channels + console (Part 04) ---
# `uv run python -m scripts.dev` fills in dev-only defaults for the four secrets below when
# they're unset; anywhere else, an unset secret means that endpoint answers 503.
# Shared secret for the ops console at /console (real auth comes in Part 07).
# BATON_CONSOLE_SECRET=
# Public base URL of the API (what Twilio calls). Twilio signs this exact URL, so set it when
# the API runs behind a proxy or tunnel.
# BATON_PUBLIC_URL=https://baton.example.com
# Where the web app lives; SMS replies too long for two segments link to the transcript here.
# BATON_WEB_URL=http://localhost:5173
# Signs those transcript links (they expire after 7 days). Unset = long SMS replies are cut
# without a link.
# BATON_LINK_SECRET=

# SMS. console = print outgoing texts (dev). twilio = send through the Twilio REST API.
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Email. console = print outgoing email (dev) | smtp | resend.
EMAIL_PROVIDER=console
EMAIL_FROM=support@northwind.example
# Inbound email webhook (POST /channels/email/inbound) checks the X-Baton-Webhook-Secret header.
# EMAIL_WEBHOOK_SECRET=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---- Simulations (Part 05) ----
# Models for the simulated customer and the LLM judge (default: BATON_MODEL).
# BATON_SIM_PERSONA_MODEL=claude-sonnet-5-5
# BATON_SIM_JUDGE_MODEL=claude-sonnet-5-5
